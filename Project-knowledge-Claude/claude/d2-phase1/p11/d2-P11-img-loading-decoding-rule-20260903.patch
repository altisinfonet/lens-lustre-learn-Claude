diff --git a/eslint-rules/require-img-loading-decoding.js b/eslint-rules/require-img-loading-decoding.js
new file mode 100644
index 0000000..c537de4
--- /dev/null
+++ b/eslint-rules/require-img-loading-decoding.js
@@ -0,0 +1,101 @@
+/**
+ * require-img-loading-decoding — P11, the first half.
+ *
+ * Every JSX `<img>` must carry BOTH `loading` and `decoding`. A bare `<img>`
+ * blocks the main thread while the browser decodes it and fetches it at the
+ * highest priority the moment it is parsed, whether or not it is anywhere near
+ * the viewport — on a mid-range Android on a slow connection that is felt as
+ * jank on a screen the member has not scrolled to yet.
+ *
+ * WHAT IT ACCEPTS
+ *   loading  : "lazy" | "eager"                (a literal, or any expression)
+ *   decoding : "async" | "sync" | "auto"       (a literal, or any expression)
+ * A non-literal value (`loading={x}`) is accepted: the attribute is present and
+ * this rule does not evaluate expressions. A literal that is not one of the
+ * values above is reported — a typo'd attribute is worse than a missing one,
+ * because it reads as done.
+ *
+ * `{...props}` — a spread may supply either attribute and this rule cannot
+ * know. It is REPORTED rather than assumed good: unknown is not a pass (C-34).
+ * Where a component genuinely forwards them, name them explicitly at the tag.
+ *
+ * ⚠ WHAT THIS RULE CANNOT SEE, recorded so nobody mistakes green for complete:
+ * `<img` written inside an HTML template string — 7 sites at 0-D2-03, listed in
+ * §2b of docs/evidence/d2/baseline/client-inventory.md. ESLint sees a string,
+ * not a tag. Those are P11's second half and need their own check.
+ *
+ * SCOPE mirrors the 0-D2-03 inventory: shipped `src/**` only. The UI harness
+ * and the test tree render fixtures whose job is to be photographed, not
+ * shipped, and `eslint-rules/**` is this file's own home.
+ */
+
+const REQUIRED = {
+  loading: ["lazy", "eager"],
+  decoding: ["async", "sync", "auto"],
+};
+
+const DIR_ALLOWLIST = ["/eslint-rules/", "/src/test/", "/__tests__/", "/src/uiharness/"];
+
+function isAllowed(filename) {
+  if (!filename) return false;
+  if (/\.(test|spec)\.[tj]sx?$/.test(filename)) return true;
+  return DIR_ALLOWLIST.some((d) => filename.includes(d));
+}
+
+/** The literal value of a JSX attribute, or undefined when it is an expression. */
+function literalValue(attribute) {
+  const v = attribute.value;
+  if (!v) return undefined;                       // bare attribute: <img loading />
+  if (v.type === "Literal") return v.value;
+  if (v.type === "JSXExpressionContainer" && v.expression.type === "Literal") return v.expression.value;
+  return undefined;                                // an expression — accepted, not evaluated
+}
+
+export default {
+  meta: {
+    type: "problem",
+    docs: {
+      description:
+        "Require both loading and decoding on every JSX <img>, so an image off-screen cannot block the main thread or steal fetch priority.",
+    },
+    schema: [],
+  },
+  create(context) {
+    const filename = context.getFilename();
+    if (isAllowed(filename)) return {};
+
+    return {
+      JSXOpeningElement(node) {
+        if (node.name.type !== "JSXIdentifier" || node.name.name !== "img") return;
+
+        const spread = node.attributes.some((a) => a.type === "JSXSpreadAttribute");
+        const present = new Map();
+        for (const a of node.attributes) {
+          if (a.type === "JSXAttribute" && a.name.type === "JSXIdentifier") {
+            present.set(a.name.name, a);
+          }
+        }
+
+        for (const [attr, allowed] of Object.entries(REQUIRED)) {
+          const found = present.get(attr);
+          if (!found) {
+            context.report({
+              node,
+              message: spread
+                ? `<img> has no explicit ${attr}. A {...spread} may or may not supply it, and this rule cannot tell — name it at the tag. Allowed: ${allowed.join(" | ")}.`
+                : `<img> is missing ${attr}. Add ${attr}="${allowed[0]}" — a bare <img> decodes on the main thread and fetches at full priority off-screen.`,
+            });
+            continue;
+          }
+          const value = literalValue(found);
+          if (value !== undefined && !allowed.includes(value)) {
+            context.report({
+              node: found,
+              message: `${attr}="${String(value)}" is not a valid value. Allowed: ${allowed.join(" | ")}.`,
+            });
+          }
+        }
+      },
+    };
+  },
+};
