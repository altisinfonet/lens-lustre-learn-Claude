+/**
+ * P11 — spec for `audit-v6/require-img-loading-decoding`.
+ *
+ * The rule is RED against `src/` on purpose until P11's sweep lands, so its own
+ * correctness cannot be read off a green repository. These cases are the proof
+ * that it accepts what the gate accepts and rejects what the gate rejects, and
+ * they stay true after the sweep has emptied the repository-wide list (C-34).
+ */
+import { describe, it } from "vitest";
+import { RuleTester } from "eslint";
+import rule from "../../eslint-rules/require-img-loading-decoding.js";
+
+const tester = new RuleTester({
+  languageOptions: {
+    ecmaVersion: 2022,
+    sourceType: "module",
+    parserOptions: { ecmaFeatures: { jsx: true } },
+  },
+});
+
+const FILE = "/repo/src/components/Foo.tsx";
+
+describe("audit-v6/require-img-loading-decoding", () => {
+  it("runs the RuleTester suite", () => {
+    tester.run("require-img-loading-decoding", rule, {
+      valid: [
+        // Both attributes, the ordinary form.
+        { filename: FILE, code: `const a = <img src={u} alt="" loading="lazy" decoding="async" />;` },
+        // The other permitted literals — an above-the-fold hero is legitimately eager.
+        { filename: FILE, code: `const a = <img src={u} alt="" loading="eager" decoding="sync" />;` },
+        { filename: FILE, code: `const a = <img src={u} alt="" loading="lazy" decoding="auto" />;` },
+        // Expressions are accepted: the attribute is present, and this rule does not evaluate.
+        { filename: FILE, code: `const a = <img src={u} loading={mode} decoding={how} />;` },
+        // Not an <img>: a component that happens to render one is P11's business, not this rule's.
+        { filename: FILE, code: `const a = <OptimizedImage src={u} alt="" />;` },
+        // Scope: the harness and the test tree render fixtures, not shipped pixels.
+        { filename: "/repo/src/uiharness/scenes.tsx", code: `const a = <img src={u} alt="" />;` },
+        { filename: "/repo/src/__tests__/Foo.test.tsx", code: `const a = <img src={u} alt="" />;` },
+        { filename: "/repo/src/test/helpers.tsx", code: `const a = <img src={u} alt="" />;` },
+      ],
+      invalid: [
+        // The bare tag — 87 of these in src/ today.
+        {
+          filename: FILE,
+          code: `const a = <img src={u} alt="" />;`,
+          errors: [{ message: /missing loading/ }, { message: /missing decoding/ }],
+        },
+        // Half-done is not done. This is the majority shape in src/: loading, no decoding.
+        {
+          filename: FILE,
+          code: `const a = <img src={u} alt="" loading="lazy" />;`,
+          errors: [{ message: /missing decoding/ }],
+        },
+        {
+          filename: FILE,
+          code: `const a = <img src={u} alt="" decoding="async" />;`,
+          errors: [{ message: /missing loading/ }],
+        },
+        // A typo'd value reads as done and is not.
+        {
+          filename: FILE,
+          code: `const a = <img src={u} alt="" loading="lazyy" decoding="async" />;`,
+          errors: [{ message: /loading="lazyy" is not a valid value/ }],
+        },
+        {
+          filename: FILE,
+          code: `const a = <img src={u} alt="" loading="lazy" decoding="asynchronous" />;`,
+          errors: [{ message: /decoding="asynchronous" is not a valid value/ }],
+        },
+        // A spread MIGHT supply them. Unknown is not a pass.
+        {
+          filename: FILE,
+          code: `const a = <img {...rest} src={u} alt="" />;`,
+          errors: [{ message: /\{\.\.\.spread\}/ }, { message: /\{\.\.\.spread\}/ }],
+        },
+      ],
+    });
+  });
+});
