+++ b/supabase/migrations/PROBE_public_grant_census.sql
+@@ -0,0 +1,171 @@
+-- ═══════════════════════════════════════════════════════════════════════════
+-- PUBLIC-GRANT CENSUS — F-62. READS ONLY. WRITES NOTHING. CHANGES NOTHING.
+--
+-- F-30, standing: an instrument that produces a published number ships with the
+-- number. docs/evidence/d1/F62/public-grant-census-2026-09-03.tsv is the output
+-- of this file against production at 2026-09-03 09:09Z. Re-run it to re-take
+-- those figures; do not re-derive them by hand.
+--
+-- The `PROBE_` prefix follows PROBE_credential_connectivity_readonly.sql: a name
+-- that tells any future reader, at a glance, that the file is not part of the
+-- migration sequence. Safe against either lane, any number of times.
+--
+-- ───────────────────────────────────────────────────────────────────────────
+-- WHAT IT MEASURES, AND WHY THE OBVIOUS QUERY IS WRONG
+--
+-- The question is "can anon execute this function", and the trap is that there
+-- are TWO ways the answer can be yes:
+--
+--   1. a named grant to anon                    -> `anon=X/...` appears in proacl
+--   2. a grant to PUBLIC, which anon inherits   -> `=X/...` appears, with an
+--                                                  EMPTY grantee before the `=`
+--
+-- and a THIRD case that looks like neither:
+--
+--   3. proacl IS NULL. This does not mean "no grants". It means "nobody has
+--      changed the defaults", and PostgreSQL's default for a function is
+--      EXECUTE to PUBLIC. A NULL ACL is the most permissive state there is,
+--      and it is the one that reads as empty.
+--
+-- So this file never reads proacl directly. It uses
+--
+--      aclexplode(coalesce(p.proacl, acldefault('f', p.proowner)))
+--
+-- which materialises the default when proacl is NULL, and it treats
+-- `grantee = 0` — the OID reserved for PUBLIC — as PUBLIC. Anything that reads
+-- proacl::text and greps for a role name misses cases 2 and 3 entirely, which
+-- is 246 of this database's 305 anon-executable functions.
+--
+-- ───────────────────────────────────────────────────────────────────────────
+-- THE FOUR CLASSES IT SORTS EVERY FUNCTION INTO
+--
+--   CLOSED            anon cannot execute it. Nothing to do.
+--   ANON-NAMED-ONLY   anon has a named grant and PUBLIC does not hold EXECUTE.
+--                     `REVOKE ... FROM anon` does what it says.
+--   TRAP-BOTH         anon has a named grant AND PUBLIC holds EXECUTE.
+--                     `REVOKE ... FROM anon` SUCCEEDS AND CHANGES NOTHING —
+--                     anon still executes, through PUBLIC.
+--   TRAP-PUBLIC-ONLY  proacl is NULL or PUBLIC holds EXECUTE with no named anon
+--                     grant. `REVOKE ... FROM anon` succeeds, removes a grant
+--                     that was never there, and changes nothing.
+--
+-- The last two are F-62. Both require `REVOKE ... FROM PUBLIC`.
+--
+-- ⚠ THE GATE THIS SERVES: for every function Phase 1 revokes, anon EXECUTE is
+-- proven absent AFTER the change by has_function_privilege('anon', oid,
+-- 'EXECUTE') = false — NOT by the REVOKE statement succeeding. On 246 of 305
+-- functions here, the REVOKE succeeding proves nothing at all.
+-- ═══════════════════════════════════════════════════════════════════════════
+
+BEGIN;
+
+-- ── 1 · The totals ─────────────────────────────────────────────────────────
+WITH acl AS (
+  SELECT p.oid, x.grantee, x.privilege_type
+    FROM pg_proc p
+    CROSS JOIN LATERAL aclexplode(coalesce(p.proacl, acldefault('f', p.proowner))) x
+   WHERE p.pronamespace = 'public'::regnamespace
+),
+f AS (
+  SELECT p.oid,
+         (p.proacl IS NULL)                                AS acl_null,
+         has_function_privilege('anon', p.oid, 'EXECUTE')  AS anon_exec,
+         EXISTS (SELECT 1 FROM acl a WHERE a.oid = p.oid AND a.grantee = 0
+                   AND a.privilege_type = 'EXECUTE')       AS public_exec,
+         EXISTS (SELECT 1 FROM acl a WHERE a.oid = p.oid
+                   AND a.grantee = 'anon'::regrole::oid
+                   AND a.privilege_type = 'EXECUTE')       AS anon_named
+    FROM pg_proc p
+   WHERE p.pronamespace = 'public'::regnamespace
+)
+SELECT count(*)                                                          AS functions_total,
+       count(*) FILTER (WHERE anon_exec)                                 AS anon_executable,
+       count(*) FILTER (WHERE anon_exec AND public_exec AND anon_named)  AS trap_both,
+       count(*) FILTER (WHERE anon_exec AND public_exec AND NOT anon_named) AS trap_public_only,
+       count(*) FILTER (WHERE anon_exec AND public_exec)                 AS trap_total,
+       count(*) FILTER (WHERE anon_exec AND NOT public_exec)             AS anon_named_only,
+       count(*) FILTER (WHERE acl_null)                                  AS proacl_null,
+       to_char(clock_timestamp() AT TIME ZONE 'utc',
+               'YYYY-MM-DD"T"HH24:MI:SS"Z"')                             AS measured_at_utc
+  FROM f;
+
+-- ── 2 · Every anon-executable function, one row each, classified ───────────
+-- Every line carries its own measurement timestamp: probes run seconds apart on
+-- a live system and a grant can change between them.
+WITH acl AS (
+  SELECT p.oid, x.grantee, x.privilege_type
+    FROM pg_proc p
+    CROSS JOIN LATERAL aclexplode(coalesce(p.proacl, acldefault('f', p.proowner))) x
+   WHERE p.pronamespace = 'public'::regnamespace
+)
+SELECT p.proname || '(' || pg_get_function_identity_arguments(p.oid) || ')' AS function,
+       p.provolatile::text                                                 AS volatility,
+       p.prosecdef                                                         AS security_definer,
+       (p.proacl IS NULL)                                                  AS proacl_is_null,
+       has_function_privilege('anon', p.oid, 'EXECUTE')                    AS anon_can_execute,
+       EXISTS (SELECT 1 FROM acl a WHERE a.oid = p.oid AND a.grantee = 0
+                 AND a.privilege_type = 'EXECUTE')                         AS public_holds_execute,
+       EXISTS (SELECT 1 FROM acl a WHERE a.oid = p.oid
+                 AND a.grantee = 'anon'::regrole::oid
+                 AND a.privilege_type = 'EXECUTE')                         AS anon_named_in_acl,
+       CASE
+         WHEN NOT has_function_privilege('anon', p.oid, 'EXECUTE') THEN 'CLOSED'
+         WHEN EXISTS (SELECT 1 FROM acl a WHERE a.oid = p.oid AND a.grantee = 0 AND a.privilege_type = 'EXECUTE')
+          AND EXISTS (SELECT 1 FROM acl a WHERE a.oid = p.oid AND a.grantee = 'anon'::regrole::oid AND a.privilege_type = 'EXECUTE')
+              THEN 'TRAP-BOTH'
+         WHEN EXISTS (SELECT 1 FROM acl a WHERE a.oid = p.oid AND a.grantee = 0 AND a.privilege_type = 'EXECUTE')
+              THEN 'TRAP-PUBLIC-ONLY'
+         ELSE 'ANON-NAMED-ONLY'
+       END                                                                 AS class,
+       coalesce(p.proacl::text, 'NULL')                                    AS proacl,
+       to_char(clock_timestamp() AT TIME ZONE 'utc',
+               'YYYY-MM-DD"T"HH24:MI:SS"Z"')                               AS measured_at_utc
+  FROM pg_proc p
+ WHERE p.pronamespace = 'public'::regnamespace
+   AND has_function_privilege('anon', p.oid, 'EXECUTE')
+ ORDER BY 8, 1;
+
+-- ── 3 · The named Phase 1 targets, and what each one actually needs ────────
+-- P30 / P31 / P32 and the P33-adjacent functions. The `required_action` column
+-- is the deliverable: it says, per function, whether the obvious REVOKE works.
+WITH acl AS (
+  SELECT p.oid, x.grantee, x.privilege_type
+    FROM pg_proc p
+    CROSS JOIN LATERAL aclexplode(coalesce(p.proacl, acldefault('f', p.proowner))) x
+   WHERE p.pronamespace = 'public'::regnamespace
+)
+SELECT CASE
+         WHEN p.proname = 'email_exists' THEN 'P30'
+         WHEN p.proname IN ('search_certificates','verify_staff_id') THEN 'P31'
+         WHEN p.proname IN ('_gen_competition_order_no','get_broadcast_feed',
+                            'increment_managed_page_view','recompute_entry_from_tag_assignments',
+                            'recompute_entry_public_status','record_test_agent_run','set_write_path')
+              THEN 'P32'
+         ELSE 'P33-adjacent'
+       END                                                                 AS unit,
+       p.proname || '(' || pg_get_function_identity_arguments(p.oid) || ')' AS function,
+       p.provolatile::text                                                 AS volatility,
+       has_function_privilege('anon', p.oid, 'EXECUTE')                    AS anon_can_execute,
+       EXISTS (SELECT 1 FROM acl a WHERE a.oid = p.oid AND a.grantee = 0
+                 AND a.privilege_type = 'EXECUTE')                         AS public_holds_execute,
+       CASE
+         WHEN NOT has_function_privilege('anon', p.oid, 'EXECUTE')
+              THEN 'already closed — nothing to do'
+         WHEN EXISTS (SELECT 1 FROM acl a WHERE a.oid = p.oid AND a.grantee = 0 AND a.privilege_type = 'EXECUTE')
+              THEN 'REVOKE FROM PUBLIC as well — an anon-only revoke is a NO-OP here'
+         ELSE 'REVOKE FROM anon works as written'
+       END                                                                 AS required_action,
+       to_char(clock_timestamp() AT TIME ZONE 'utc',
+               'YYYY-MM-DD"T"HH24:MI:SS"Z"')                               AS measured_at_utc
+  FROM pg_proc p
+ WHERE p.pronamespace = 'public'::regnamespace
+   AND p.proname IN ('email_exists','search_certificates','verify_staff_id',
+                     '_gen_competition_order_no','get_broadcast_feed','increment_managed_page_view',
+                     'recompute_entry_from_tag_assignments','recompute_entry_public_status',
+                     'record_test_agent_run','set_write_path',
+                     'enqueue_email','read_email_batch','get_primary_admin_user_id')
+ ORDER BY 1, 2;
+
+-- Nothing above writes. This is belt and braces, so that a future edit which
+-- introduces a write by accident still cannot leave a change behind.
+ROLLBACK;
