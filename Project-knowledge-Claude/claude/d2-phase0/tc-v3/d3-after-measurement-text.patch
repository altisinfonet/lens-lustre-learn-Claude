+#!/usr/bin/env node
+/**
+ * TC-v3 - AFTER measurement - REAL ENGINE, LOCAL ORIGIN.
+ *
+ *   npm run build   (with the lane VITE_ vars set)
+ *   python3 -m http.server 4173 --bind 127.0.0.1   # from dist/
+ *   node docs/evidence/d2/tc-v3/local-render-measure.mjs
+ *
+ * WHY LOCALHOST. Four Playwright configurations against staging.50mmretina.com
+ * were reset by this container's egress proxy (curl through it returns 200,
+ * Chromium does not). 127.0.0.1 is in no_proxy, so the proxy is not in the path
+ * at all. The bundle served is the one `npm run build` produced from the merged
+ * client half, so the COMPONENT under test is the real one.
+ *
+ * ALL DATA IS INJECTED via route interception - nothing reaches a real backend,
+ * and the build carries the repo's synthetic hermetic Supabase values, never a
+ * credential. Every run is therefore SUBSTITUTED and is labelled so. Substituted
+ * data proves the CARD; it never proves a lane's data.
+ *
+ * TWO NAME SETS, both with production's real numbers (read read-only from
+ * jtdtehuqtinjxropkkcn 2026-09-03 15:59:10.224553Z):
+ *   PROD-NAMES  Amit Baran Sen (14) / Mainak Mridha (13) / Dipannita Sen (13)
+ *   NAME-21     all three replaced by "Partha Sarathi Moulik" (21) - the longest
+ *               display name on production eligible for the card, read
+ *               09:18:25.228393Z. Staging's longest eligible name is 12, shorter
+ *               than the row section 3.1 calls tightest, so staging data alone
+ *               cannot exercise the width obligation.
+ *
+ * THIS is where the ellipsis is proved. jsdom cannot: it computes no layout.
+ */
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const HERE = path.dirname(fileURLToPath(import.meta.url));
+let chromium;
+try { ({ chromium } = await import('playwright')); }
+catch { ({ chromium } = (await import('/home/claude/.npm-global/lib/node_modules/playwright/index.js')).default); }
+
+const ORIGIN = process.env.TC_V3_ORIGIN || 'http://127.0.0.1:4173/';
+const NAME_21 = 'Partha Sarathi Moulik';
+
+const TRIO = [
+  { user_id: 'u1', rank_position: 1, contributor_score: 9143,  recent_score: 7233, name: 'Amit Baran Sen' },
+  { user_id: 'u2', rank_position: 2, contributor_score: 9551,  recent_score: 7055, name: 'Mainak Mridha' },
+  { user_id: 'u3', rank_position: 3, contributor_score: 11546, recent_score: 6823, name: 'Dipannita Sen' },
+];
+
+const VIEWPORTS = [
+  { name: 'phone-360x800',    width: 360,  height: 800,  mobile: true },
+  { name: 'desktop-1280x800', width: 1280, height: 800,  mobile: false },
+];
+
+const probe = () => {
+  const px = (n) => Math.round(n * 100) / 100;
+  const h3 = [...document.querySelectorAll('h3')].find((e) => /top contributors/i.test(e.textContent || ''));
+  if (!h3) return { error: 'card heading not found' };
+  let card = h3;
+  for (let i = 0; i < 6 && card.parentElement; i++) {
+    card = card.parentElement;
+    if (card.className && /rounded-xl/.test(String(card.className))) break;
+  }
+  const cb = card.getBoundingClientRect();
+  const rows = [...card.querySelectorAll('div.rounded-lg')]
+    .filter((d) => /px-3/.test(String(d.className || '')) && d.querySelector('img, .uppercase'));
+  return {
+    cardHeight: px(cb.height), cardWidth: px(cb.width), cardBottomY: px(cb.bottom),
+    viewportHeight: window.innerHeight,
+    cardExtendsBelowFold: cb.bottom > window.innerHeight,
+    rowCount: rows.length,
+    rows: rows.map((r) => {
+      const nameEl = r.querySelector('.truncate');
+      const cs = nameEl ? getComputedStyle(nameEl) : null;
+      const texts = [...r.querySelectorAll('div, span')].map((e) => (e.textContent || '').trim());
+      const bar = r.querySelector('div[style*="width"]');
+      return {
+        rowHeight: px(r.getBoundingClientRect().height),
+        name: nameEl ? (nameEl.textContent || '').trim() : null,
+        nameChars: nameEl ? (nameEl.textContent || '').trim().length : null,
+        nameBoxWidth: nameEl ? px(nameEl.getBoundingClientRect().width) : null,
+        nameClientWidth: nameEl ? nameEl.clientWidth : null,
+        nameScrollWidth: nameEl ? nameEl.scrollWidth : null,
+        ELLIPSIS_ACTIVE: nameEl ? nameEl.scrollWidth > nameEl.clientWidth : null,
+        textOverflow: cs ? cs.textOverflow : null,
+        whiteSpace: cs ? cs.whiteSpace : null,
+        overflow: cs ? cs.overflow : null,
+        primary30d: texts.find((t) => /^✦\s*[\d,]+\s*30d$/.test(t)) ?? null,
+        lifetimeLine: texts.find((t) => /^Lifetime\s+[\d,]+$/.test(t)) ?? null,
+        barWidthStyle: bar ? bar.style.width : null,
+      };
+    }),
+  };
+};
+
+const digits = (s) => Number((String(s ?? '').match(/[\d,]+/) ?? ['0'])[0].replace(/,/g, ''));
+
+const browser = await chromium.launch({
+  executablePath: process.env.TC_V3_CHROME || undefined,
+  args: ['--no-sandbox', '--proxy-bypass-list=<-loopback>', '--proxy-server=direct://'],
+});
+
+const results = [];
+for (const v of VIEWPORTS) {
+  for (const mode of ['PROD-NAMES', 'NAME-21']) {
+    const ctx = await browser.newContext({
+      viewport: { width: v.width, height: v.height },
+      isMobile: v.mobile, hasTouch: v.mobile, deviceScaleFactor: v.mobile ? 3 : 1,
+      ...(v.mobile ? { userAgent: 'Mozilla/5.0 (Linux; Android 13; moto g54 5G) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Mobile Safari/537.36' } : {}),
+    });
+    const page = await ctx.newPage();
+    const nameFor = (i) => (mode === 'NAME-21' ? NAME_21 : TRIO[i].name);
+
+    await page.route('**/rest/v1/**', async (route) => {
+      const url = route.request().url();
+      const json = (b) => route.fulfill({ status: 200, contentType: 'application/json', body: JSON.stringify(b) });
+      if (url.includes('rpc/get_top_contributors_v3')) {
+        return json(TRIO.map(({ user_id, rank_position, contributor_score, recent_score }) =>
+          ({ user_id, rank_position, contributor_score, recent_score })));
+      }
+      if (url.includes('profiles_public_data')) {
+        return json(TRIO.map((t, i) => ({ id: t.user_id, full_name: nameFor(i), avatar_url: null, last_active_at: null })));
+      }
+      return json([]);
+    });
+
+    const rec = { viewport: v.name, mode, label: 'SUBSTITUTED', origin: ORIGIN, measured_utc: new Date().toISOString() };
+    try {
+      await page.goto(ORIGIN, { waitUntil: 'networkidle', timeout: 45000 });
+      await page.evaluate(() => {
+        const h = [...document.querySelectorAll('h3')].find((e) => /top contributors/i.test(e.textContent || ''));
+        if (h) h.scrollIntoView({ block: 'center' });
+      });
+      await page.waitForTimeout(2500);
+      Object.assign(rec, await page.evaluate(probe));
+      // The consent banner is fixed-position and covers the card on a 360px
+      // viewport. It is HIDDEN for the capture, never accepted or dismissed -
+      // no consent is simulated, and hiding it after probe() cannot affect the
+      // geometry already measured (the banner is out of the card's flow).
+      await page.addStyleTag({ content: `
+        [class*="fixed"]:has(> * ) { }
+      ` }).catch(() => {});
+      await page.evaluate(() => {
+        for (const el of Array.from(document.querySelectorAll('div, section, aside'))) {
+          const t = el.textContent || '';
+          if (/We Value Your Privacy|cookies to enhance/i.test(t) && t.length < 600) {
+            const cs = getComputedStyle(el);
+            if (cs.position === 'fixed' || cs.position === 'sticky') { el.setAttribute('data-hidden-for-capture',''); el.style.display = 'none'; }
+          }
+        }
+      });
+      await page.waitForTimeout(400);
+      const shot = path.join(HERE, `after-${v.name}-${mode}.png`);
+      const box = await page.evaluate(() => {
+        const h = [...document.querySelectorAll('h3')].find((e) => /top contributors/i.test(e.textContent || ''));
+        if (!h) return null;
+        let c = h; for (let i = 0; i < 6 && c.parentElement; i++) { c = c.parentElement; if (c.className && /rounded-xl/.test(String(c.className))) break; }
+        const b = c.getBoundingClientRect();
+        return { x: Math.max(0, b.x - 8), y: Math.max(0, b.y - 8), width: b.width + 16, height: b.height + 16 };
+      });
+      if (box && box.width > 0) await page.screenshot({ path: shot, clip: box });
+      rec.screenshot = shot;
+      if (rec.rows && rec.rows.length) {
+        const n = rec.rows.map((r) => digits(r.primary30d));
+        rec.displayed = n;
+        rec.gate_3_4_descending = n.every(Number.isFinite) && n.every((x, i) => i === 0 || n[i - 1] >= x);
+        rec.barPercents = rec.rows.map((r) => r.barWidthStyle);
+        rec.anyBarOver100 = rec.rows.some((r) => parseFloat(String(r.barWidthStyle)) > 100);
+      }
+    } catch (e) { rec.error = String(e).split('\n')[0]; }
+    results.push(rec);
+    await ctx.close();
+  }
+}
+await browser.close();
+console.log(JSON.stringify({ note: 'Every run is SUBSTITUTED: data injected via route interception. Proves the CARD, not a lane.', results }, null, 2));
