+#!/usr/bin/env node
+/**
+ * TC-v3 - section 3.4 SUBSTITUTED gate - runner. NO BROWSER REQUIRED.
+ *
+ *   node docs/evidence/d2/tc-v3/run-substituted-gate.mjs
+ *
+ * Exit 0 = gate passes. Exit 1 = 3.4 FAILS, stop and report. Exit 2 = the
+ * harness could not run, which is NOT a pass.
+ *
+ * WHY A RUNNER AND NOT JUST A TEST
+ *
+ * The instrument is src/__tests__/topContributorsV3.substituted.test.tsx, a
+ * vitest file so it runs in CI with everything else and cannot rot unnoticed.
+ * This wrapper exists so there is ONE command printing a 3.4 verdict rather
+ * than a test summary to interpret - the role after-measure.prepared.mjs plays
+ * for the render measurements, minus the browser that never worked here.
+ *
+ * WHAT IT PROVES, AND WHAT IT DOES NOT
+ *
+ * PROVES: given production's trio - recent 7,055/6,978/6,823 against lifetime
+ * 9,551/8,888/11,546 - the rendered card displays the ranking figures and they
+ * descend, while the lifetime figures it also shows do not. Shown FAILING on a
+ * mutated component (primary reverted to contributor_score), 2026-09-03:
+ *
+ *     FAIL  displays the 30-day figures, and they DESCEND
+ *           expected [ 9551, 8888, 11546 ] to deeply equal [ 7055, 6978, 6823 ]
+ *     FAIL  never presents the lifetime figure as the primary one
+ *           expected [ 9551, 8888, 11546 ] to not include 9551
+ *
+ * DOES NOT PROVE: the lane's data, the ellipsis, or any rendered geometry.
+ * jsdom performs no layout. SUBSTITUTED data proves the CARD, never the lane -
+ * it does not replace the production reading after promotion.
+ */
+import { spawn } from 'node:child_process';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const REPO = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../../..');
+const TEST = 'src/__tests__/topContributorsV3.substituted.test.tsx';
+
+console.log('TC-v3 section 3.4 SUBSTITUTED gate');
+console.log('repo:', REPO);
+console.log('instrument:', TEST, '\n');
+
+const child = spawn('npx', ['vitest', 'run', TEST, '--reporter=basic'], {
+  cwd: REPO, stdio: ['ignore', 'pipe', 'pipe'], env: process.env,
+});
+
+let out = '';
+child.stdout.on('data', (b) => { const s = b.toString(); out += s; process.stdout.write(s); });
+child.stderr.on('data', (b) => { const s = b.toString(); out += s; process.stderr.write(s); });
+
+child.on('error', (e) => {
+  console.error('\nHARNESS COULD NOT RUN: ' + e.message);
+  console.error('This is NOT a pass. Install dependencies (npm ci) and retry.');
+  process.exit(2);
+});
+
+child.on('close', (code) => {
+  const ran = /Tests\s+\d+/.test(out);
+  console.log('\n' + '-'.repeat(64));
+  if (!ran) {
+    console.error('3.4 VERDICT: HARNESS DID NOT RUN - not a pass. Exit 2.');
+    process.exit(2);
+  }
+  if (code === 0) {
+    console.log('3.4 VERDICT: PASS - the displayed figures descend on production data,');
+    console.log('             and the lifetime figures the card also shows do not.');
+    console.log('             SUBSTITUTED: proves the card, not the lane. The production');
+    console.log('             reading after promotion is still owed.');
+    process.exit(0);
+  }
+  console.error('3.4 VERDICT: FAIL - STOP AND REPORT. Do not tune.');
+  console.error('             The ranking field and the displayed field disagree;');
+  console.error('             the change has not fixed the thing it was written for.');
+  process.exit(1);
+});
