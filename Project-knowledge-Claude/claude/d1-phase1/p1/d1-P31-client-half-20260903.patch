+/**
+ * P31 · TELL "DENIED" APART FROM "EMPTY".
+ *
+ * Before this, handleSearchByDetails collapsed every failure into one branch:
+ *
+ *     if (error || !data || data.length === 0) { setNotFound(true); }
+ *
+ * so a `42501 permission denied` and a genuine empty result rendered the same
+ * "No Certificates Found". Once EXECUTE on search_certificates is revoked from
+ * anon (P31, supabase/migrations/20260910_0001), a real certificate holder
+ * searching for their own name is told their certificate does not exist. That
+ * is a confident wrong answer, and nobody reports it as a bug.
+ *
+ * TWO CODES, NOT ONE, because there are two ways the revoke can surface:
+ *   42501    PostgREST reached the function and Postgres refused the caller.
+ *   PGRST202 PostgREST's schema cache no longer lists the function for this
+ *            role, so the call never reaches Postgres. Which one appears
+ *            depends on whether the schema cache has reloaded since the
+ *            revoke, and both mean the same thing to a visitor.
+ *
+ * The message substring is a deliberate last resort, not the primary test:
+ * codes are the contract, prose is not. It is here because a proxy or an older
+ * PostgREST can deliver the refusal without the code, and reverting to "not
+ * found" in that case would restore the exact defect this function exists to
+ * remove.
+ *
+ * Exported so it can be tested without rendering the page. A control that can
+ * only be exercised through a full render is a control that stops being run.
+ */
+export const SEARCH_UNAVAILABLE_CODES = ["42501", "PGRST202"] as const;
+
+export function isSearchUnavailableError(error: unknown): boolean {
+  if (!error || typeof error !== "object") return false;
+  const e = error as { code?: unknown; message?: unknown };
+  const code = typeof e.code === "string" ? e.code : "";
+  if ((SEARCH_UNAVAILABLE_CODES as readonly string[]).includes(code)) return true;
+  const message = typeof e.message === "string" ? e.message.toLowerCase() : "";
+  return message.includes("permission denied");
+}
