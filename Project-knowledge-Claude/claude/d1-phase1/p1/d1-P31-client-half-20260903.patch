+/**
+ * P31 · /verify must not answer "not found" when it was refused.
+ *
+ * THE DEFECT THIS PINS
+ *
+ * handleSearchByDetails used to collapse every failure into one branch:
+ *
+ *     if (error || !data || data.length === 0) { setNotFound(true); }
+ *
+ * so a `42501 permission denied` rendered as "No Certificates Found". Once
+ * EXECUTE on search_certificates is revoked from anon — P31,
+ * supabase/migrations/20260910_0001_revoke_public_search_certificates.sql —
+ * a real certificate holder searching their own name is told their
+ * certificate does not exist. Wrong, confident, and invisible in support.
+ *
+ * THIS TEST WAS SHOWN FAILING AGAINST THE UNPATCHED COMPONENT BEFORE THE FIX
+ * WAS ACCEPTED (C-34). The failing assertion was "Certificate ID" copy absent
+ * / "No Certificates Found" present.
+ *
+ * The empty-result case is asserted too, in the same file and deliberately so:
+ * a fix that turned EVERY empty search into "unavailable" would pass the first
+ * test and be a worse bug than the one it replaced.
+ */
+
+import { describe, it, expect, vi, beforeEach } from "vitest";
+import { render, screen, fireEvent, waitFor } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+
+const rpc = vi.fn();
+
+vi.mock("@/integrations/supabase/client", () => ({
+  supabase: {
+    rpc: (...args: unknown[]) => rpc(...args),
+  },
+}));
+
+import VerifyCertificate from "@/pages/VerifyCertificate";
+import { isSearchUnavailableError } from "@/pages/verifyCertificateErrors";
+
+const UNAVAILABLE_COPY =
+  "This search is no longer available, please verify by certificate ID";
+const NOT_FOUND_COPY = "No Certificates Found";
+
+function renderPage() {
+  return render(
+    <MemoryRouter initialEntries={["/verify"]}>
+      <VerifyCertificate />
+    </MemoryRouter>,
+  );
+}
+
+/** Switch to "By Name / Course", type a name, submit. */
+async function searchByName(name = "Jane Doe") {
+  fireEvent.click(screen.getByText(/By Name \/ Course/i));
+  const input = await screen.findByPlaceholderText(/John Doe/i);
+  fireEvent.change(input, { target: { value: name } });
+  fireEvent.click(screen.getByRole("button", { name: /Search Certificates/i }));
+}
+
+describe("isSearchUnavailableError", () => {
+  it("recognises Postgres 42501 — PostgREST reached the function and was refused", () => {
+    expect(
+      isSearchUnavailableError({
+        code: "42501",
+        message: "permission denied for function search_certificates",
+      }),
+    ).toBe(true);
+  });
+
+  it("recognises PGRST202 — the function is gone from the schema cache for this role", () => {
+    expect(
+      isSearchUnavailableError({
+        code: "PGRST202",
+        message: "Could not find the function public.search_certificates",
+      }),
+    ).toBe(true);
+  });
+
+  it("falls back to the message when a proxy strips the code", () => {
+    expect(
+      isSearchUnavailableError({ message: "ERROR: permission denied for function" }),
+    ).toBe(true);
+  });
+
+  it("does NOT treat an ordinary failure as a revoke", () => {
+    expect(isSearchUnavailableError(null)).toBe(false);
+    expect(isSearchUnavailableError(undefined)).toBe(false);
+    expect(isSearchUnavailableError({ code: "PGRST116", message: "no rows" })).toBe(false);
+    expect(isSearchUnavailableError({ message: "Failed to fetch" })).toBe(false);
+    expect(isSearchUnavailableError("permission denied")).toBe(false);
+  });
+});
+
+describe("/verify · search by details after the P31 revoke", () => {
+  beforeEach(() => {
+    rpc.mockReset();
+  });
+
+  it("shows the unavailable message, NOT 'not found', on 42501", async () => {
+    rpc.mockResolvedValue({
+      data: null,
+      error: { code: "42501", message: "permission denied for function search_certificates" },
+    });
+
+    renderPage();
+    await searchByName();
+
+    await waitFor(() => {
+      expect(screen.getByText(UNAVAILABLE_COPY)).toBeTruthy();
+    });
+    // The whole point: the old copy must be gone, not merely accompanied.
+    expect(screen.queryByText(NOT_FOUND_COPY)).toBeNull();
+  });
+
+  it("shows the unavailable message on PGRST202 as well", async () => {
+    rpc.mockResolvedValue({
+      data: null,
+      error: { code: "PGRST202", message: "Could not find the function" },
+    });
+
+    renderPage();
+    await searchByName();
+
+    await waitFor(() => {
+      expect(screen.getByText(UNAVAILABLE_COPY)).toBeTruthy();
+    });
+    expect(screen.queryByText(NOT_FOUND_COPY)).toBeNull();
+  });
+
+  it("still says 'not found' for a genuine empty result — the fix must not over-reach", async () => {
+    rpc.mockResolvedValue({ data: [], error: null });
+
+    renderPage();
+    await searchByName();
+
+    await waitFor(() => {
+      expect(screen.getByText(NOT_FOUND_COPY)).toBeTruthy();
+    });
+    expect(screen.queryByText(UNAVAILABLE_COPY)).toBeNull();
+  });
+
+  it("still says 'not found' for an unrelated error", async () => {
+    rpc.mockResolvedValue({ data: null, error: { code: "PGRST116", message: "no rows" } });
+
+    renderPage();
+    await searchByName();
+
+    await waitFor(() => {
+      expect(screen.getByText(NOT_FOUND_COPY)).toBeTruthy();
+    });
+    expect(screen.queryByText(UNAVAILABLE_COPY)).toBeNull();
+  });
+
+  it("clears the unavailable panel when the visitor switches to By Certificate ID", async () => {
+    rpc.mockResolvedValue({
+      data: null,
+      error: { code: "42501", message: "permission denied for function search_certificates" },
+    });
+
+    renderPage();
+    await searchByName();
+    await waitFor(() => {
+      expect(screen.getByText(UNAVAILABLE_COPY)).toBeTruthy();
+    });
+
+    // getByText would match twice here: the mode button AND the words
+    // "verify by certificate ID" inside the message we just asserted. The role
+    // query is unambiguous. (Caught by this test failing on the FIXED
+    // component — the test was wrong, not the fix.)
+    fireEvent.click(screen.getByRole("button", { name: /By Certificate ID/i }));
+    await waitFor(() => {
+      expect(screen.queryByText(UNAVAILABLE_COPY)).toBeNull();
+    });
+  });
+});
