+-- P31 · search_certificates — close anonymous access. REVOKE FROM PUBLIC *AND* anon.
+--
+-- =============================================================================
+-- ⚠ READ THIS BEFORE APPLYING. THERE IS A LIVE CLIENT CALL SITE.
+--
+--   src/pages/VerifyCertificate.tsx:101
+--     const { data, error } = await supabase.rpc("search_certificates", { ... });
+--
+--   src/App.tsx:410
+--     <Route path="/verify" element={<VerifyCertificate />} />   ← NO auth guard
+--
+-- /verify is a PUBLIC, UNAUTHENTICATED page and it has two modes:
+--
+--   mode "id"       -> verify_certificate(_cert_id)      NOT touched by this file
+--   mode "details"  -> search_certificates(name, title, date)   ← THIS FILE CLOSES IT
+--
+-- After this migration an anonymous visitor using "search by details" gets
+-- SQLSTATE 42501. The page does NOT surface that. Its handler reads:
+--
+--     if (error || !data || data.length === 0) { setNotFound(true); }
+--
+-- so a permission denial renders as **"Certificate not found"**. The page will
+-- tell a real certificate holder their certificate does not exist. That is worse
+-- than an error banner, because it is a wrong answer delivered confidently and
+-- nobody will report it as a bug.
+--
+-- ⚠ THEREFORE: CLIENT FIRST, DATABASE SECOND. D2 removes or gates the
+-- "search by details" mode, that lands, and only then is this file applied.
+-- Applying this first is a self-inflicted support incident, not a security win.
+--
+-- The revoke itself is correct and P31 wants it: search_certificates takes a
+-- person's NAME and returns their certificates. Anonymous name-search is the
+-- enumeration class the phase exists to close. The disagreement is about
+-- ORDER, not about whether.
+--
+-- ⚠ PRECONDITION NOT MET AS OF 2026-09-03 12:30Z. The method requires D2's
+-- call-site inventory delivered and the revocation list frozen by the Auditor
+-- BEFORE this SQL is written. docs/evidence/d2/ does not exist on this ref and
+-- docs/gates/ holds only GATE_REGISTER.md and phase-0-kickoff.md. The two call
+-- sites above were found by D1 reading src/ read-only. That is a measurement,
+-- not an inventory, and D2's inventory remains the authority. The guard below
+-- exists because of that gap.
+--
+-- =============================================================================
+-- WHY BOTH REVOKES, MEASURED — F-62
+--
+-- production pg_proc.proacl, 2026-09-03 12:28:13Z:
+--
+--   {=X/postgres,postgres=X/postgres,anon=X/postgres,
+--    authenticated=X/postgres,service_role=X/postgres}
+--
+-- The leading `=X/postgres` is PUBLIC. This function is class TRAP-BOTH: anon
+-- holds a NAMED grant and also inherits one through PUBLIC. So:
+--
+--   REVOKE ... FROM anon    alone  -> succeeds, anon STILL EXECUTES (via PUBLIC)
+--   REVOKE ... FROM PUBLIC  alone  -> succeeds, anon STILL EXECUTES (named grant)
+--   both                           -> closed
+--
+-- Both single-revoke cases were run on a scratch PostgreSQL 16.13 and shown
+-- failing this file's own verification block before this file was accepted
+-- (C-34). Transcript: docs/evidence/d1/P1/P1-fixture-transcript.txt
+--
+-- =============================================================================
+-- WHY authenticated IS DEPRECATED FROM *NOTHING* HERE
+--
+-- authenticated holds a NAMED grant (`authenticated=X/postgres`, same reading),
+-- so REVOKE FROM PUBLIC does not take it away. That is deliberate and it is
+-- checked below, not assumed: the frozen Phase 1 list says revoke from anon.
+-- Widening that to authenticated would exceed the list, and a revoke that
+-- exceeds its authorisation is how a security unit becomes an outage.
+--
+-- If the Owner decides logged-in name-search is also enumeration and should go,
+-- that is a separate unit with its own client change. It is NOT smuggled in here.
+--
+-- =============================================================================
+-- F-66 — THIS DOES NOT STAY DONE BY ITSELF
+--
+-- Production's ALTER DEFAULT PRIVILEGES rule ADDS TO the built-in default rather
+-- than replacing it, so every function created in schema public is born with
+-- PUBLIC holding EXECUTE. And F-64: DROP + CREATE resets proacl to NULL, which
+-- is PUBLIC again. This function reopens the first time its signature changes.
+-- The verification block below is re-runnable for exactly that reason.
+-- =============================================================================
+
+
+-- ─────────────────────────────────────────────────────────────────────────────
+-- GUARD · refuses unless the applier states the client change has landed.
+--
+-- Satisfy it in the same session, immediately before this file:
+--     SET d1.ack_search_certificates_client_updated = 'yes';
+--
+-- Delete this block if the Auditor would rather carry the ordering in the
+-- ledger than in the file. It is here because the failure mode is silent.
+-- ─────────────────────────────────────────────────────────────────────────────
+DO $guard$
+BEGIN
+  IF coalesce(current_setting('d1.ack_search_certificates_client_updated', true), '') <> 'yes' THEN
+    RAISE EXCEPTION
+      'REFUSED: /verify "search by details" still calls search_certificates as anon. Land D2 client change first, then SET d1.ack_search_certificates_client_updated = ''yes'';'
+      USING ERRCODE = 'raise_exception';
+  END IF;
+END
+$guard$;
+
+
+REVOKE ALL ON FUNCTION public.search_certificates(_name text, _course_title text, _issued_date date) FROM PUBLIC;
+REVOKE ALL ON FUNCTION public.search_certificates(_name text, _course_title text, _issued_date date) FROM anon;
+
+
+-- ─────────────────────────────────────────────────────────────────────────────
+-- VERIFICATION · F-66. This RAISES, so a bad state cannot be committed.
+--
+-- ⚠ A SELECT that returns a verdict column cannot stop an apply — it reports.
+-- The gate needs a statement that FAILS the transaction, so the assertions live
+-- in this DO block and the SELECT that follows is the record, not the control.
+-- ─────────────────────────────────────────────────────────────────────────────
+DO $verify$
+DECLARE
+  f_oid       oid;
+  anon_can    boolean;
+  auth_can    boolean;
+  public_has  boolean;
+BEGIN
+  -- to_regprocedure resolves by TYPE signature and returns NULL when the function
+  -- is absent. pg_get_function_identity_arguments() is NOT used here: it includes
+  -- PARAMETER NAMES when the function has them, so a match against 'text, text,
+  -- date' finds nothing on a function declared with named parameters. That defect
+  -- was in this file and the fixture caught it before delivery.
+  f_oid := to_regprocedure('public.search_certificates(text, text, date)')::oid;
+
+  IF f_oid IS NULL THEN
+    RAISE EXCEPTION 'VERIFY FAILED: public.search_certificates(text, text, date) does not exist.';
+  END IF;
+
+  anon_can   := has_function_privilege('anon',          f_oid, 'EXECUTE');
+  auth_can   := has_function_privilege('authenticated', f_oid, 'EXECUTE');
+  public_has := EXISTS (SELECT 1 FROM pg_proc p
+                        CROSS JOIN LATERAL aclexplode(coalesce(p.proacl, acldefault('f', p.proowner))) x
+                        WHERE p.oid = f_oid AND x.grantee = 0 AND x.privilege_type = 'EXECUTE');
+
+  IF public_has THEN
+    RAISE EXCEPTION 'VERIFY FAILED: PUBLIC still holds EXECUTE (proacl %). The REVOKE FROM PUBLIC did not take.',
+      (SELECT coalesce(proacl::text,'NULL') FROM pg_proc WHERE oid = f_oid);
+  END IF;
+
+  IF anon_can THEN
+    RAISE EXCEPTION 'VERIFY FAILED: anon can still EXECUTE (proacl %). F-62: the REVOKE succeeded and changed nothing.',
+      (SELECT coalesce(proacl::text,'NULL') FROM pg_proc WHERE oid = f_oid);
+  END IF;
+
+  IF NOT auth_can THEN
+    RAISE EXCEPTION 'VERIFY FAILED: authenticated LOST EXECUTE (proacl %). This revoke exceeded the frozen Phase 1 list and breaks logged-in certificate search.',
+      (SELECT coalesce(proacl::text,'NULL') FROM pg_proc WHERE oid = f_oid);
+  END IF;
+END
+$verify$;
+
+
+-- The F-66 verification SELECT — the row that goes in the evidence file.
+SELECT 'P31 · search_certificates(text, text, date)'                       AS unit,
+       coalesce(p.proacl::text, 'NULL')                                    AS proacl,
+       EXISTS (SELECT 1 FROM aclexplode(coalesce(p.proacl, acldefault('f', p.proowner))) x
+                WHERE x.grantee = 0 AND x.privilege_type = 'EXECUTE')       AS public_holds_execute,
+       has_function_privilege('anon',          p.oid, 'EXECUTE')            AS anon_execute,
+       has_function_privilege('authenticated', p.oid, 'EXECUTE')            AS authenticated_execute,
+       has_function_privilege('service_role',  p.oid, 'EXECUTE')            AS service_role_execute,
+       CASE WHEN NOT EXISTS (SELECT 1 FROM aclexplode(coalesce(p.proacl, acldefault('f', p.proowner))) x
+                              WHERE x.grantee = 0 AND x.privilege_type = 'EXECUTE')
+             AND NOT has_function_privilege('anon',          p.oid, 'EXECUTE')
+             AND     has_function_privilege('authenticated', p.oid, 'EXECUTE')
+            THEN 'PASS' ELSE 'FAIL' END                                     AS verdict,
+       to_char(clock_timestamp() AT TIME ZONE 'utc',
+               'YYYY-MM-DD"T"HH24:MI:SS"Z"')                                AS measured_at_utc
+  FROM pg_proc p
+ WHERE p.pronamespace = 'public'::regnamespace
+   AND p.oid = to_regprocedure('public.search_certificates(text, text, date)')::oid;
