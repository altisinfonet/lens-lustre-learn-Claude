+-- ROLLBACK for 20260910_0001_revoke_public_search_certificates.sql
+--
+-- =============================================================================
+-- ⚠ ORDER: DATABASE FIRST, CLIENT SECOND — the OPPOSITE of the apply.
+--
+-- The apply is client-first because it REMOVES a capability the client uses.
+-- The rollback is database-first because it RESTORES one. Running this file
+-- alone is a complete rollback for anything a member can see: /verify's
+-- "search by details" mode starts working again the moment it commits, with no
+-- deploy. If D2's client change has already landed, reverting it is a separate,
+-- unhurried step.
+--
+-- =============================================================================
+-- WHAT THIS RESTORES, AND WHAT IT DELIBERATELY DOES NOT
+--
+-- The pre-apply state, production 2026-09-03 12:28:13Z, was:
+--
+--   {=X/postgres,postgres=X/postgres,anon=X/postgres,
+--    authenticated=X/postgres,service_role=X/postgres}
+--
+-- This file restores anon's NAMED grant. It does **NOT** restore the leading
+-- `=X/postgres`, i.e. the grant to PUBLIC.
+--
+-- That is a deliberate deviation from byte-identical restoration, and the
+-- reason is F-62: the PUBLIC grant is the trap itself. anon's reach is restored
+-- exactly — anon can execute the function again, which is the whole point of a
+-- rollback — while the property that makes a future `REVOKE ... FROM anon` a
+-- silent no-op is not put back. Restoring PUBLIC would re-arm the trap for no
+-- gain to any caller: through PostgREST the reachable roles are anon,
+-- authenticated and service_role, and all three hold named grants.
+--
+-- If the Auditor requires byte-identical restoration instead, the change is to
+-- add `GRANT EXECUTE ... TO PUBLIC;` below. I recommend against it and have
+-- said so rather than making the choice silently.
+-- =============================================================================
+
+GRANT EXECUTE ON FUNCTION public.search_certificates(_name text, _course_title text, _issued_date date) TO anon;
+
+DO $verify$
+DECLARE f_oid oid;
+BEGIN
+  -- to_regprocedure resolves by TYPE signature and returns NULL when the function
+  -- is absent. pg_get_function_identity_arguments() is NOT used here: it includes
+  -- PARAMETER NAMES when the function has them, so a match against 'text, text,
+  -- date' finds nothing on a function declared with named parameters. That defect
+  -- was in this file and the fixture caught it before delivery.
+  f_oid := to_regprocedure('public.search_certificates(text, text, date)')::oid;
+
+  IF f_oid IS NULL THEN
+    RAISE EXCEPTION 'ROLLBACK FAILED: public.search_certificates(text, text, date) does not exist.';
+  END IF;
+
+  IF NOT has_function_privilege('anon', f_oid, 'EXECUTE') THEN
+    RAISE EXCEPTION 'ROLLBACK FAILED: anon still cannot EXECUTE (proacl %). /verify search-by-details is still closed.',
+      (SELECT coalesce(proacl::text,'NULL') FROM pg_proc WHERE oid = f_oid);
