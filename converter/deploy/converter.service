# 50mm Retina World · the video converter worker (CONVERTER-DESIGN.md v2 §6).
# Installed by setup.sh at /etc/systemd/system/converter.service
# (@NODE_BIN@ is replaced with the Node 22 binary's path). This file IS the
# staging lane; `setup.sh --lane live` renders converter-live.service from it
# (lane-lib.sh: user converter-live, /var/lib/converter-live, its own env file,
# job space and sandbox-unit prefix, and this lane's directories hidden from it).
#
# Its own unprivileged user `converter`; outbound HTTPS only; it may write
# only its state (claim file, session file) and the job space. FFmpeg never runs in here: every
# ffprobe/ffmpeg is a converter-ff@<job>.service (user ffjob, no network).

[Unit]
Description=50mm Retina World video converter worker
After=network-online.target var-lib-converter-jobs.mount
Wants=network-online.target
Requires=var-lib-converter-jobs.mount
# A start that keeps failing (the self-test, the credentials) is retried, not hammered.
StartLimitIntervalSec=900
StartLimitBurst=10

[Service]
Type=exec
User=converter
Group=converter
SupplementaryGroups=convjob
EnvironmentFile=/etc/converter/converter.env
Environment=NODE_ENV=production
Environment=CONVERTER_LAUNCHER=systemd
# This lane's own files and sandbox units (converter-live.service names the live lane's).
Environment=CONVERTER_CREDENTIALS_FILE=/var/lib/converter/secrets/credentials.json
Environment=CONVERTER_SECRETS_DIR=/var/lib/converter/secrets
Environment=CONVERTER_STATE_FILE=/var/lib/converter/state/claim.json
# the persisted Supabase session (refresh token, 0600): state/ is hidden from FFmpeg runs and the other lane
Environment=CONVERTER_SESSION_FILE=/var/lib/converter/state/session.json
Environment=CONVERTER_JOBS_DIR=/var/lib/converter/jobs
Environment=CONVERTER_UNIT_PREFIX=converter-ff
ExecStart=@NODE_BIN@ /opt/converter/worker.mjs
WorkingDirectory=/var/lib/converter
Restart=always
RestartSec=30
# Exit 4 = stopped on purpose: a presigned URL outside this lane's R2 pin (a misconfiguration,
# or Pages changed). Not restarted — every further job would fail too (re-review N4).
# After fixing /etc/converter/converter.env: sudo systemctl start converter.service
RestartPreventExitStatus=4
# SIGTERM to the worker only: it ends its job with `finish fail internal`
# (requeued at once), stops its FFmpeg run, and exits.
KillMode=mixed
TimeoutStopSec=90
UMask=0007

MemoryMax=6G
TasksMax=64
LimitCORE=0

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/converter/state /var/lib/converter/jobs
# The OTHER lane's secrets, state and job space: invisible, whatever the file modes say
# (lane separation; sandbox-check.sh --selftest proves it under the real unit).
InaccessiblePaths=-/var/lib/converter-live
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateIPC=yes
KeyringMode=private
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# HTTPS out (IPv4/6), D-Bus to systemd/polkit (unix), glibc's resolver (netlink)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Never the link-local range: 169.254.169.254 is the cloud's instance-metadata
# service (and, on OCI, its DNS resolver). DNS is unaffected — the worker asks
# systemd-resolved at 127.0.0.53 (Ubuntu's default), and resolved, outside this
# unit, asks upstream. Proven by `sandbox-check.sh --selftest` (worker.mjs --netcheck).
IPAddressDeny=link-local
# Not set on purpose: MemoryDenyWriteExecute (Node's JIT needs it off),
# PrivateNetwork (the worker talks to Supabase, Pages and R2).

[Install]
WantedBy=multi-user.target
