# 50mm Retina World · converter worker settings → /etc/converter/converter.env
# (root:converter 0640). Nothing here is secret: the Supabase URL and anon key
# are public. The converter's PASSWORD is never here — it lives only in
# /var/lib/converter/secrets/credentials.json (converter:converter 0600),
# written by the separate provisioning step.

# The lane's Pages origin (the /api/video/* Functions), origin only — no path.
CONVERTER_API_BASE=https://REPLACE-with-the-lane-site-origin
# The lane's Supabase project (origin only) and its public anon key.
CONVERTER_SUPABASE_URL=https://REPLACE-project-ref.supabase.co
CONVERTER_SUPABASE_ANON_KEY=REPLACE-with-the-lane-anon-key

# Optional (defaults shown)
#CONVERTER_X264_PRESET=veryfast
#CONVERTER_POLL_MS=10000
#CONVERTER_POLL_MAX_MS=60000
#CONVERTER_HEARTBEAT_MS=120000
#CONVERTER_STARTUP_SELFTEST=1
#CONVERTER_CREDENTIALS_FILE=/var/lib/converter/secrets/credentials.json
#CONVERTER_STATE_FILE=/var/lib/converter/state/claim.json
#CONVERTER_JOBS_DIR=/var/lib/converter/jobs
