# 50mm Retina World · the LIVE lane's converter worker settings → /etc/converter/converter-live.env
# (root:converter-live 0640, written by `setup.sh --lane live` from this file). Nothing here
# is secret: the Supabase URL and anon key are public. The live converter's PASSWORD is never
# here — it lives only in /var/lib/converter-live/secrets/credentials.json
# (converter-live:converter-live 0600), written by the separate Owner-run provisioning step
# for the live converter account video-converter@50mmretina.com. The live project wants a CAPTCHA
# for password sign-in, so the live worker runs on a SEEDED session: README.md, "The persisted session".
#
# The lane's own paths and sandbox units (credentials, session file, secrets, state, jobs,
# CONVERTER_UNIT_PREFIX=converter-live-ff) are set in converter-live.service itself —
# do NOT set them here.

# The live site's origin (the /api/video/* Pages Functions), origin only — no path.
CONVERTER_API_BASE=https://www.50mmretina.com
# The live Supabase project (origin only) and its public anon key.
CONVERTER_SUPABASE_URL=https://jtdtehuqtinjxropkkcn.supabase.co
CONVERTER_SUPABASE_ANON_KEY=REPLACE-with-the-live-anon-key
# The R2 S3 endpoint host (same Cloudflare account as staging) — the ONLY host a presigned
# URL may name — and the LIVE video bucket: presigned paths must start /50mm-video/upload/.
# A URL outside this pin ends that job and the worker stops claiming (exit 4, ALERT log).
CONVERTER_R2_HOST=REPLACE-32-hex-account-id.r2.cloudflarestorage.com
CONVERTER_R2_BUCKET=50mm-video

# Optional (defaults shown)
#CONVERTER_X264_PRESET=veryfast
#CONVERTER_POLL_MS=10000
#CONVERTER_POLL_MAX_MS=60000
#CONVERTER_HEARTBEAT_MS=120000
#CONVERTER_STARTUP_SELFTEST=1
# S7-f purge tick: drain POST /api/video/purge at most this often (ms); 0 = off; else 60000..86400000.
#CONVERTER_PURGE_EVERY_MS=3600000
