# 50mm Retina World — web client environment (EXAMPLE — contains no real values)
# Copy to .env.local for local development. .env.local is gitignored.
# The real values per environment live ONLY in Cloudflare Pages project settings:
#   production Pages project -> production values
#   50mm-staging Pages project -> staging values
# A build with these unset FAILS at the isolation guard (scripts/verify-bundle-isolation.mjs).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
